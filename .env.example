NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀 키 (처음 설정에서 엄마·아빠 계정을 만들 때만 사용). 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자(/admin) 비밀번호 (비워 두면 1234). 인터넷에 배포할 땐 꼭 바꾸세요.
ADMIN_PASSWORD=
# (선택) 관리자 로그인 쿠키 서명용 비밀 값. 비워 두면 서비스 키에서 파생
ADMIN_SESSION_SECRET=

# 로그인 아이디 뒤에 자동으로 붙는 내부 이메일 도메인 (실제 메일은 발송되지 않음)
NEXT_PUBLIC_AUTH_DOMAIN=sticker.example.com
